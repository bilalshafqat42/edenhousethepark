# Copy to .env.local and fill in. Never commit .env.local.

# Mapbox public access token (starts with pk.). In your Mapbox account,
# restrict it to the site's URLs: edenhousethepark.com,
# stg.edenhousethepark.com, the onrender.com addresses and localhost.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Mapbox Studio style URL, e.g. mapbox://styles/<account>/<style-id>
NEXT_PUBLIC_MAPBOX_STYLE_URL=

# Chat contact buttons (optional)
NEXT_PUBLIC_CALL_NUMBER=
NEXT_PUBLIC_WHATSAPP_NUMBER=
