# Eden House The Park: environment variables.
#
# Copy to .env.local for development. Every variable is optional locally:
# with none set the site builds and renders exactly as designed, from the
# committed snapshot (src/content/snapshot.json) and the defaults in
# src/content/sections/. Never commit real values; set them on Render.
#
# Live service    (branch main): SITE_KEY=edenhousethepark
# Staging service (branch stg):  SITE_KEY=edenhousethepark-staging
# Each has its OWN API key and revalidate secret, issued in the admin panel.

# ---------------------------------------------------------------
# Admin panel connection
# ---------------------------------------------------------------

# The panel's base URL. Setting it is the switch that makes content come
# from the panel; clearing it falls back to the snapshot and defaults.
CONTENT_API_URL=https://projects-admin.refinedubai.com

# This site's API key, from the panel (the site's settings > API keys).
# Used for content, the manifest push at boot, preview-link checks and
# lead intake. Secret.
CONTENT_API_TOKEN=

# Which panel site this deployment is.
SITE_KEY=edenhousethepark

# The site's own address, with https://. Required in production: canonical
# links, share previews and the sitemap use it. A stg- address marks the
# deployment as staging (never indexed).
#   live:    https://edenhousethepark.refinedubai.com
#   staging: https://stg-edenhousethepark.refinedubai.com
SITE_URL=

# The panel calls POST /api/revalidate with "Authorization: Bearer <this>"
# after every save, so edits show at once. Must equal the revalidate secret
# stored against this site in the panel. Secret.
REVALIDATE_SECRET=

# Optional: how long panel content may be cached, in seconds (a safety net
# behind the revalidate webhook). Default 300. Never 0.
CONTENT_CACHE_SECONDS=

# Optional: a different host or key for lead intake only. Default: the two
# CONTENT_API_* values above, as on Movenpick and Oceara.
LEAD_API_URL=
LEAD_INTAKE_TOKEN=

# ---------------------------------------------------------------
# Images
# ---------------------------------------------------------------

# Hosts allowed to serve images (where the panel stores uploads). Read at
# BUILD time. Default: media.refinedubai.com.
IMAGE_HOSTS=media.refinedubai.com

# true: images are resized by Cloudflare at the edge (/cdn-cgi/image/...).
# Only on refinedubai.com addresses, where Image Resizing is on. Read at
# BUILD time. Leave unset locally.
CLOUDFLARE_IMAGE_RESIZING=

# ---------------------------------------------------------------
# Staging protection and visitor IP
# ---------------------------------------------------------------

# Staging only, optional: asks for this password (HTTP Basic) before any
# page. Username "refine" unless STAGING_USERNAME is set. Never on live.
STAGING_PASSWORD=
STAGING_USERNAME=

# Optional, recommended: a random value (openssl rand -hex 32) that a
# Cloudflare Transform Rule adds as the x-origin-secret header. With it, the
# visitor IP from Cloudflare is trusted only on requests that came through
# Cloudflare, so the lead rate limit cannot be dodged by calling the
# onrender.com address directly. Secret.
CF_ORIGIN_SECRET=

# ---------------------------------------------------------------
# Map and chat (public, compiled in at BUILD time)
# ---------------------------------------------------------------

# Mapbox public token (starts with pk.). In Mapbox, restrict it to the
# site's addresses: edenhousethepark.refinedubai.com,
# stg-edenhousethepark.refinedubai.com, the onrender.com addresses and
# localhost.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Mapbox Studio style URL, e.g. mapbox://styles/<account>/<style-id>
NEXT_PUBLIC_MAPBOX_STYLE_URL=

# Chat contact buttons. Optional fallbacks: the panel's Chat Widget section
# wins when its fields are filled in.
NEXT_PUBLIC_CALL_NUMBER=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---------------------------------------------------------------
# Optional extra lead destination (off unless set)
# ---------------------------------------------------------------

# Zapier webhooks that also receive each enquiry and each chat call-back
# slot, alongside the panel. X-Bot-Secret header sent when the secret is set.
ZAPIER_EDEN_LEAD_WEBHOOK=
ZAPIER_EDEN_SLOT_WEBHOOK=
ZAPIER_BOT_SECRET=
